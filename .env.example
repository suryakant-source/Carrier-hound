# ============================================================
# CareerMonke / Career Hound Environment Variables
# ============================================================

# Supabase Public API (safe for browser and frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (PRIVATE — server / ingestion pipeline / cron only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Model Strategy (Groq OpenAI-compatible endpoints)
GROQ_API_KEY=gsk_...
FAST_MODEL=openai/gpt-oss-20b
SMART_MODEL=openai/gpt-oss-120b

# Daily Automated Cron Secret
CRON_SECRET=careermonke_cron_secret_key_123

# Billing — Razorpay (Domestic Rs 199/month)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Billing — Stripe (International $9/month)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
