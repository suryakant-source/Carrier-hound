# ============================================================
# CareerMonke / Career Hound Environment Variables
# ============================================================

# Supabase Public API (safe for browser and frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (PRIVATE — server / ingestion pipeline only)
# NEVER commit this key or expose it to client-side code!
# In GitHub Actions, add this to Repository Secrets.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
